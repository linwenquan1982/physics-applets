<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Wave Graphs: y–x vs y–t</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: #0f0f1a;
    color: #e0e0e0;
    font-family: 'Segoe UI', Arial, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding: 18px 10px 24px;
  }
  h1 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #b8c8ff;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .subtitle {
    font-size: 0.78rem;
    color: #6a7a9a;
    margin-bottom: 16px;
  }
  .panels {
    display: flex;
    gap: 20px;
    width: 100%;
    max-width: 1060px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .panel {
    background: #13152a;
    border: 1px solid #2a2f50;
    border-radius: 12px;
    padding: 14px 16px 10px;
    flex: 1 1 460px;
    min-width: 300px;
  }
  .panel-title { font-size: 0.88rem; font-weight: 600; margin-bottom: 4px; }
  .panel-desc  { font-size: 0.72rem; color: #5a6a8a; margin-bottom: 10px; line-height: 1.5; }
  canvas { display: block; width: 100%; border-radius: 8px; }

  .time-badge {
    display: inline-block;
    background: #1e2240;
    border: 1px solid #3a4070;
    border-radius: 8px;
    padding: 5px 18px;
    font-size: 1rem;
    font-weight: 700;
    color: #ffdd77;
    letter-spacing: 0.06em;
    margin: 10px 0 6px;
    min-width: 140px;
    text-align: center;
  }
  .controls {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }
  button {
    background: #1e2450;
    color: #c8d4ff;
    border: 1px solid #3a4580;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.15s;
  }
  button:hover { background: #2a3368; }
  button.active { background: #3040a0; border-color: #6080ff; color: #fff; }
  .speed-label { font-size: 0.78rem; color: #6a7a9a; margin-left: 4px; }
  input[type=range] { accent-color: #5570e0; width: 90px; cursor: pointer; }

  .legend {
    display: flex;
    gap: 20px;
    margin-top: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .leg-item { display: flex; align-items: center; gap: 7px; font-size: 0.75rem; color: #8090b0; }
  .leg-dot  { width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0; }
  .leg-line { width: 24px; height: 3px; border-radius: 2px; flex-shrink: 0; }
  .frame-counter { font-size: 0.72rem; color: #4a5a7a; margin-top: 2px; }
</style>
</head>
<body>

<h1>Displacement–Distance vs Displacement–Time</h1>
<p class="subtitle">A transverse wave &nbsp;y(x, t) = A sin(kx − ωt)&nbsp; — watch one particle traced across both graphs</p>

<div class="time-badge" id="timeBadge">t = 0.00 s</div>
<div class="frame-counter" id="frameCounter">Frame 0</div>

<div class="panels">
  <div class="panel">
    <div class="panel-title" style="color:#5ec8ff">y–x &nbsp;(Displacement–Distance) Graph</div>
    <div class="panel-desc">
      Snapshot of ALL particles at the <strong>current instant</strong>. Each dot is a different particle.
      The highlighted <span style="color:#ffaa33">■ orange particle</span> moves up and down as time advances.
    </div>
    <canvas id="cvYX" height="240"></canvas>
  </div>
  <div class="panel">
    <div class="panel-title" style="color:#ff7aaa">y–t &nbsp;(Displacement–Time) Graph</div>
    <div class="panel-desc">
      History of <strong>one particle</strong> (x = x₀) over time. Each point recorded once per frame.
      Shows how that single particle oscillates — the wave itself is not visible here.
    </div>
    <canvas id="cvYT" height="240"></canvas>
  </div>
</div>

<div class="legend">
  <div class="leg-item"><div class="leg-line" style="background:#5ec8ff"></div>Wave (all particles)</div>
  <div class="leg-item"><div class="leg-dot" style="background:#ffaa33; border:2px solid #ff8800"></div>Highlighted particle (x = x₀)</div>
  <div class="leg-item"><div class="leg-line" style="background:#ff7aaa"></div>y–t trace of highlighted particle</div>
  <div class="leg-item"><div class="leg-dot" style="background:#ffdd77; border:2px solid #ffcc00"></div>Current position on y–t graph</div>
</div>

<div class="controls">
  <button id="btnPlayPause" class="active">⏸ Pause</button>
  <button id="btnStep">Step +1</button>
  <button id="btnReset">↺ Reset</button>
  <span class="speed-label">Speed:</span>
  <input type="range" id="speedSlider" min="1" max="10" value="4">
  <span id="speedVal" class="speed-label">×4</span>
</div>

<script>
// ─── Wave parameters ──────────────────────────────────────────────
const A        = 1;
const λ        = 2;
const T_period = 4;
const k        = (2 * Math.PI) / λ;
const ω        = (2 * Math.PI) / T_period;
const x0       = 1.0;           // highlighted particle position (m)
const dt_frame = 0.1;           // seconds per frame
const totalFrames = 80;
const xMin = 0, xMax = 4;
const tMin = 0, tMax = totalFrames * dt_frame;

// ─── State ────────────────────────────────────────────────────────
let frame    = 0;
let playing  = true;
let speed    = 4;
let lastTime = null;
let accumMs  = 0;
let ytData   = [];

// ─── Canvas setup ─────────────────────────────────────────────────
const cvYX = document.getElementById('cvYX');
const cvYT = document.getElementById('cvYT');
const ctxYX = cvYX.getContext('2d');
const ctxYT = cvYT.getContext('2d');
const MARG = { top: 30, bottom: 40, left: 52, right: 20 };

function resize() {
  const pw = cvYX.parentElement.clientWidth - 32;
  cvYX.width = cvYT.width = pw;
  cvYX.height = cvYT.height = 240;
}
resize();
window.addEventListener('resize', () => { resize(); render(); });

// ─── Coordinate helpers ───────────────────────────────────────────
function yx_px(x, y) {
  const W = cvYX.width, H = cvYX.height;
  return [
    MARG.left + (x - xMin) / (xMax - xMin) * (W - MARG.left - MARG.right),
    MARG.top  + (1 - (y + A) / (2 * A))    * (H - MARG.top  - MARG.bottom)
  ];
}
function yt_px(t, y) {
  const W = cvYT.width, H = cvYT.height;
  return [
    MARG.left + (t - tMin) / (tMax - tMin) * (W - MARG.left - MARG.right),
    MARG.top  + (1 - (y + A) / (2 * A))    * (H - MARG.top  - MARG.bottom)
  ];
}

// ─── Axes & grid ─────────────────────────────────────────────────
function drawAxes(ctx, cvW, cvH, isTime) {
  const pw = cvW - MARG.left - MARG.right;
  const ph = cvH - MARG.top  - MARG.bottom;

  ctx.strokeStyle = '#2a3050'; ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const py = MARG.top + ph * i / 4;
    ctx.beginPath(); ctx.moveTo(MARG.left, py); ctx.lineTo(cvW - MARG.right, py); ctx.stroke();
  }
  for (let i = 0; i <= 8; i++) {
    const px = MARG.left + pw * i / 8;
    ctx.beginPath(); ctx.moveTo(px, MARG.top); ctx.lineTo(px, cvH - MARG.bottom); ctx.stroke();
  }

  // Zero line & y-axis
  const [,y0py] = isTime ? yt_px(tMin, 0) : yx_px(xMin, 0);
  ctx.strokeStyle = '#4a5580'; ctx.lineWidth = 1.5;
  ctx.beginPath(); ctx.moveTo(MARG.left, y0py); ctx.lineTo(cvW - MARG.right, y0py); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(MARG.left, MARG.top); ctx.lineTo(MARG.left, cvH - MARG.bottom); ctx.stroke();

  // Tick labels
  ctx.fillStyle = '#5a6a8a'; ctx.font = '11px Segoe UI, Arial'; ctx.textAlign = 'center';
  for (let i = 0; i <= 8; i++) {
    const val = isTime ? tMin + (tMax - tMin) * i / 8 : xMin + (xMax - xMin) * i / 8;
    const px  = MARG.left + pw * i / 8;
    ctx.fillText(val.toFixed(isTime ? 1 : 0), px, cvH - MARG.bottom + 14);
  }
  ctx.textAlign = 'right';
  [A, 0, -A].forEach(v => {
    const [,py] = isTime ? yt_px(0, v) : yx_px(0, v);
    ctx.fillText(v === 0 ? '0' : v > 0 ? '+A' : '−A', MARG.left - 6, py + 4);
  });

  ctx.fillStyle = '#8090b0'; ctx.font = 'bold 12px Segoe UI, Arial'; ctx.textAlign = 'center';
  ctx.fillText(isTime ? 't  (s)' : 'x  (m)', cvW / 2, cvH - 4);
  ctx.save();
  ctx.translate(13, cvH / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText('y  (displacement)', 0, 0);
  ctx.restore();
}

// ─── Annotation helpers ───────────────────────────────────────────

// Returns opacity for an annotation active in [showFrom, fadeEnd), full until showUntilFull
function annotAlpha(f, showFrom, showUntilFull, fadeEnd) {
  if (f < showFrom || f >= fadeEnd) return 0;
  if (f <= showUntilFull) return 1;
  return 1 - (f - showUntilFull) / (fadeEnd - showUntilFull);
}

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.arcTo(x + w, y, x + w, y + r, r);
  ctx.lineTo(x + w, y + h - r);
  ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
  ctx.lineTo(x + r, y + h);
  ctx.arcTo(x, y + h, x, y + h - r, r);
  ctx.lineTo(x, y + r);
  ctx.arcTo(x, y, x + r, y, r);
  ctx.closePath();
}

// Draw a multi-line text bubble. Returns [bx, by, bw, bh].
function drawBubble(ctx, bx, by, lines, alpha, {
  bg     = '#151c3a',
  border = '#3a4580',
  color  = '#c8d8ff',
  size   = 11,
  pad    = 9,
  lh     = 15
} = {}) {
  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.font = `${size}px Segoe UI, Arial`;
  const bw = Math.max(...lines.map(l => ctx.measureText(l).width)) + pad * 2;
  const bh = lines.length * lh + pad * 1.6;
  roundRect(ctx, bx, by, bw, bh, 7);
  ctx.fillStyle = bg;   ctx.fill();
  ctx.strokeStyle = border; ctx.lineWidth = 1.4; ctx.stroke();
  ctx.fillStyle = color;
  lines.forEach((l, i) => ctx.fillText(l, bx + pad, by + pad + size + i * lh));
  ctx.restore();
  return [bx, by, bw, bh];
}

// Draw an arrow from (x1,y1) → (x2,y2)
function drawArrow(ctx, x1, y1, x2, y2, alpha, {
  color = '#ffdd77', lw = 1.6, head = 8
} = {}) {
  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = lw;
  const ang = Math.atan2(y2 - y1, x2 - x1);
  ctx.beginPath();
  ctx.moveTo(x1, y1);
  ctx.lineTo(x2 - Math.cos(ang) * head * 0.7, y2 - Math.sin(ang) * head * 0.7);
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(x2, y2);
  ctx.lineTo(x2 - head * Math.cos(ang - Math.PI/6), y2 - head * Math.sin(ang - Math.PI/6));
  ctx.lineTo(x2 - head * Math.cos(ang + Math.PI/6), y2 - head * Math.sin(ang + Math.PI/6));
  ctx.closePath(); ctx.fill();
  ctx.restore();
}

// Draw a horizontal dashed line
function drawDash(ctx, x1, y, x2, alpha, color = '#ffaa33') {
  ctx.save();
  ctx.globalAlpha = alpha;
  ctx.strokeStyle = color; ctx.lineWidth = 1.6;
  ctx.setLineDash([5, 5]);
  ctx.beginPath(); ctx.moveTo(x1, y); ctx.lineTo(x2, y); ctx.stroke();
  ctx.setLineDash([]);
  ctx.restore();
}

// ─── Annotations: y-x graph ──────────────────────────────────────
function drawAnnotationsYX(t) {
  const W = cvYX.width, H = cvYX.height;
  const yHL = A * Math.sin(k * x0 - ω * t);
  const [hx, hy] = yx_px(x0, yHL);
  const [, hy0]  = yx_px(x0, 0);  // y=0 pixel level

  // ── Horizontal mapping line (frames 0–1 full, fades by frame 6) ──
  const alphaLine = annotAlpha(frame, 0, 1, 6);
  if (alphaLine > 0) {
    drawDash(ctxYX, hx + 10, hy, W - MARG.right, alphaLine * 0.85);
    // "maps to →" label at right edge
    ctxYX.save();
    ctxYX.globalAlpha = alphaLine * 0.85;
    ctxYX.fillStyle = '#ffaa33';
    ctxYX.font = 'bold 11px Segoe UI, Arial';
    ctxYX.textAlign = 'right';
    ctxYX.fillText('→', W - MARG.right + 1, hy + 4);
    ctxYX.restore();
  }

  // ── Frame 0: "snapshot" info bubble (bottom-right) ──
  const alpha0snap = annotAlpha(frame, 0, 0, 5);
  if (alpha0snap > 0) {
    const blines = ['This is a SNAPSHOT in time.', 'Every dot = a different particle.'];
    ctxYX.font = '10.5px Segoe UI, Arial';
    const bw = Math.max(...blines.map(l => ctxYX.measureText(l).width)) + 8 * 2;
    const bh = blines.length * 14 + 8 * 1.6;
    drawBubble(ctxYX, W - MARG.right - bw - 8, H - MARG.bottom - bh - 10, blines, alpha0snap,
      { bg: '#0d1830dd', border: '#5ec8ff88', color: '#a0d8ff', size: 10.5, pad: 8, lh: 14 }
    );
  }

  // ── Frames 0–1: orange particle callout ──
  const alpha01 = annotAlpha(frame, 0, 1, 6);
  if (alpha01 > 0) {
    // Position callout to the right of the dot, above when frame 1 (dot moves up)
    const bx = hx + 18;
    const by = Math.max(MARG.top + 4, hy - 52);
    const lines = frame === 0
      ? ['Orange particle (x₀)', 'y = 0 → at equilibrium', 't = 0.00 s']
      : [`Orange particle (x₀)`, `y ≈ ${yHL >= 0 ? '+' : ''}${yHL.toFixed(2)}`, `t = ${t.toFixed(2)} s → displaced`];
    const [bx_, by_, bw, bh] = drawBubble(ctxYX, bx, by, lines, alpha01,
      { bg: '#1f1400cc', border: '#ff880088', color: '#ffcc88', size: 10.5, pad: 8, lh: 14 }
    );
    // Arrow from left edge of bubble → dot
    drawArrow(ctxYX, bx_, by_ + bh / 2, hx + 9, hy, alpha01,
      { color: '#ffaa33', lw: 1.5, head: 7 });

    // Frame 0 only: vertical "at equilibrium" indicator line from dot to x-axis
    if (frame === 0) {
      ctxYX.save();
      ctxYX.globalAlpha = alpha01 * 0.6;
      ctxYX.strokeStyle = '#ffaa33';
      ctxYX.lineWidth = 1.4;
      ctxYX.setLineDash([3, 4]);
      ctxYX.beginPath();
      ctxYX.moveTo(hx, hy); ctxYX.lineTo(hx, hy0);
      ctxYX.stroke();
      ctxYX.setLineDash([]);
      // "y = 0" at the zero line
      ctxYX.fillStyle = '#ffaa33';
      ctxYX.font = '10px Segoe UI';
      ctxYX.textAlign = 'left';
      ctxYX.fillText('y = 0', hx + 5, hy0 - 3);
      ctxYX.restore();
    }

    // Frame 1: displacement arrow (vertical, showing how much particle moved)
    if (frame === 1 && yHL !== 0) {
      const dir = yHL > 0 ? -1 : 1;
      drawArrow(ctxYX, hx - 22, hy0, hx - 22, hy, alpha01,
        { color: '#ff7aaa', lw: 1.4, head: 7 });
      ctxYX.save();
      ctxYX.globalAlpha = alpha01;
      ctxYX.fillStyle = '#ff7aaa';
      ctxYX.font = '10px Segoe UI';
      ctxYX.textAlign = 'right';
      ctxYX.fillText('displaced', hx - 26, (hy + hy0) / 2 + 4);
      ctxYX.restore();
    }
  }
}

// ─── Annotations: y-t graph ──────────────────────────────────────
function drawAnnotationsYT(t) {
  const W = cvYT.width, H = cvYT.height;
  const yHL = A * Math.sin(k * x0 - ω * t);
  const [dotX, dotY] = yt_px(t, yHL);
  const [, y0py]     = yt_px(tMin, 0);   // y=0 pixel level

  // ── Horizontal mapping line from left edge → yellow dot (matching y-x) ──
  const alphaLine = annotAlpha(frame, 0, 1, 6);
  if (alphaLine > 0) {
    drawDash(ctxYT, MARG.left, dotY, dotX - 10, alphaLine * 0.85);
    // "← maps here" label at left edge
    ctxYT.save();
    ctxYT.globalAlpha = alphaLine * 0.85;
    ctxYT.fillStyle = '#ffaa33';
    ctxYT.font = 'bold 11px Segoe UI, Arial';
    ctxYT.textAlign = 'left';
    ctxYT.fillText('←', MARG.left - 1, dotY + 4);
    ctxYT.restore();
  }

  // ── Frame 0: "one particle" info bubble (bottom-right) ──
  const alpha0main = annotAlpha(frame, 0, 0, 5);
  if (alpha0main > 0) {
    const blines = ['Only ONE particle tracked here.', 'Not the whole wave — just x₀.'];
    ctxYT.font = '10.5px Segoe UI, Arial';
    const bw = Math.max(...blines.map(l => ctxYT.measureText(l).width)) + 8 * 2;
    const bh = blines.length * 14 + 8 * 1.6;
    drawBubble(ctxYT, W - MARG.right - bw - 8, H - MARG.bottom - bh - 10, blines, alpha0main,
      { bg: '#1a0d20dd', border: '#ff7aaa88', color: '#ffaacc', size: 10.5, pad: 8, lh: 14 }
    );
  }

  // ── Frames 0–1: yellow dot callout ──
  const alpha01 = annotAlpha(frame, 0, 1, 6);
  if (alpha01 > 0) {
    // Place callout to the right of the dot (but the dot at t=0 is near left edge, so go right)
    const bx = Math.min(dotX + 14, W * 0.45);
    const by = Math.max(MARG.top + 4, dotY - 56);

    const lines = frame === 0
      ? ['t = 0.00 s, y = 0', 'Particle starts at equilibrium.', 'Dot placed here ↓']
      : [`t = ${t.toFixed(2)} s`, `y ≈ ${yHL >= 0 ? '+' : ''}${yHL.toFixed(2)}`, 'Dot moves right + up'];
    const [bx_, by_, bw, bh] = drawBubble(ctxYT, bx, by, lines, alpha01,
      { bg: '#1a1600cc', border: '#ffcc0088', color: '#ffee99', size: 10.5, pad: 8, lh: 14 }
    );

    // Arrow from bottom-left of bubble → dot
    drawArrow(ctxYT, bx_, by_ + bh / 2, dotX + 8, dotY, alpha01,
      { color: '#ffdd77', lw: 1.5, head: 7 });

    // Frame 1: arrow showing rightward movement on t-axis
    if (frame === 1) {
      const [t0x] = yt_px(0, 0);
      drawArrow(ctxYT, t0x + 4, H - MARG.bottom - 10, dotX - 4, H - MARG.bottom - 10, alpha01,
        { color: '#ffdd77', lw: 1.4, head: 6 });
      ctxYT.save();
      ctxYT.globalAlpha = alpha01;
      ctxYT.fillStyle = '#ffdd77';
      ctxYT.font = '10px Segoe UI';
      ctxYT.textAlign = 'center';
      ctxYT.fillText(`t = ${t.toFixed(2)} s`, (t0x + dotX) / 2, H - MARG.bottom - 22);
      ctxYT.restore();
    }
  }
}

// ─── Draw y-x graph ───────────────────────────────────────────────
function drawYX(t) {
  const W = cvYX.width, H = cvYX.height;
  ctxYX.clearRect(0, 0, W, H);
  ctxYX.fillStyle = '#0d0f20'; ctxYX.fillRect(0, 0, W, H);
  drawAxes(ctxYX, W, H, false);

  // Wave curve
  ctxYX.beginPath(); ctxYX.strokeStyle = '#5ec8ff'; ctxYX.lineWidth = 2.2;
  for (let i = 0; i <= 400; i++) {
    const x = xMin + (xMax - xMin) * i / 400;
    const [cx, cy] = yx_px(x, A * Math.sin(k * x - ω * t));
    i === 0 ? ctxYX.moveTo(cx, cy) : ctxYX.lineTo(cx, cy);
  }
  ctxYX.stroke();

  // Particle dots
  for (let i = 0; i <= 40; i++) {
    const x = xMin + (xMax - xMin) * i / 40;
    if (Math.abs(x - x0) < (xMax - xMin) / 80) continue;
    const [cx, cy] = yx_px(x, A * Math.sin(k * x - ω * t));
    ctxYX.beginPath(); ctxYX.arc(cx, cy, 3.5, 0, 2*Math.PI);
    ctxYX.fillStyle = '#5ec8ff99'; ctxYX.fill();
  }

  // Highlighted particle
  const yHL = A * Math.sin(k * x0 - ω * t);
  const [hx, hy] = yx_px(x0, yHL);

  // Vertical dashed line particle → x-axis
  const [, hy0] = yx_px(x0, 0);
  ctxYX.beginPath(); ctxYX.setLineDash([4,4]);
  ctxYX.strokeStyle = '#ffaa3360'; ctxYX.lineWidth = 1.2;
  ctxYX.moveTo(hx, hy); ctxYX.lineTo(hx, hy0); ctxYX.stroke();
  ctxYX.setLineDash([]);

  // Glow
  const grd = ctxYX.createRadialGradient(hx, hy, 0, hx, hy, 18);
  grd.addColorStop(0, '#ffaa3388'); grd.addColorStop(1, 'transparent');
  ctxYX.fillStyle = grd; ctxYX.beginPath(); ctxYX.arc(hx, hy, 18, 0, 2*Math.PI); ctxYX.fill();

  // Dot
  ctxYX.beginPath(); ctxYX.arc(hx, hy, 7, 0, 2*Math.PI);
  ctxYX.fillStyle = '#ffaa33'; ctxYX.fill();
  ctxYX.strokeStyle = '#ff8800'; ctxYX.lineWidth = 2; ctxYX.stroke();

  // x₀ label
  ctxYX.fillStyle = '#ffaa33'; ctxYX.font = 'bold 11px Segoe UI';
  ctxYX.textAlign = 'center'; ctxYX.fillText('x₀', hx, H - MARG.bottom + 25);

  // Corner label (only when annotations are gone)
  const alphaStatic = Math.max(0, 1 - annotAlpha(frame, 0, 1, 4) * 3);
  ctxYX.fillStyle = `rgba(94,200,255,${0.8 * alphaStatic})`;
  ctxYX.font = '11px Segoe UI'; ctxYX.textAlign = 'left';
  ctxYX.fillText('All particles shown at this instant', MARG.left + 4, MARG.top - 8);

  // Annotations on top
  drawAnnotationsYX(t);
}

// ─── Draw y-t graph ───────────────────────────────────────────────
function drawYT(t) {
  const W = cvYT.width, H = cvYT.height;
  ctxYT.clearRect(0, 0, W, H);
  ctxYT.fillStyle = '#0d0f20'; ctxYT.fillRect(0, 0, W, H);
  drawAxes(ctxYT, W, H, true);

  // Faint full trace preview
  ctxYT.beginPath(); ctxYT.strokeStyle = '#ff7aaa22'; ctxYT.lineWidth = 1.5;
  for (let i = 0; i <= 400; i++) {
    const ti = tMin + (tMax - tMin) * i / 400;
    const [cx, cy] = yt_px(ti, A * Math.sin(k * x0 - ω * ti));
    i === 0 ? ctxYT.moveTo(cx, cy) : ctxYT.lineTo(cx, cy);
  }
  ctxYT.stroke();

  // Recorded trace
  if (ytData.length > 1) {
    ctxYT.beginPath(); ctxYT.strokeStyle = '#ff7aaa'; ctxYT.lineWidth = 2.2;
    ytData.forEach(({ t: ti, y }, i) => {
      const [cx, cy] = yt_px(ti, y);
      i === 0 ? ctxYT.moveTo(cx, cy) : ctxYT.lineTo(cx, cy);
    });
    ctxYT.stroke();
    ytData.forEach(({ t: ti, y }, i) => {
      if (i === ytData.length - 1) return;
      const [cx, cy] = yt_px(ti, y);
      ctxYT.beginPath(); ctxYT.arc(cx, cy, 2.5, 0, 2*Math.PI);
      ctxYT.fillStyle = '#ff7aaa88'; ctxYT.fill();
    });
  }

  // Current point (yellow dot)
  if (ytData.length > 0) {
    const { t: lt, y: ly } = ytData[ytData.length - 1];
    const [cx, cy] = yt_px(lt, ly);
    const grd = ctxYT.createRadialGradient(cx, cy, 0, cx, cy, 16);
    grd.addColorStop(0, '#ffdd7788'); grd.addColorStop(1, 'transparent');
    ctxYT.fillStyle = grd; ctxYT.beginPath(); ctxYT.arc(cx, cy, 16, 0, 2*Math.PI); ctxYT.fill();
    ctxYT.beginPath(); ctxYT.arc(cx, cy, 6, 0, 2*Math.PI);
    ctxYT.fillStyle = '#ffdd77'; ctxYT.fill();
    ctxYT.strokeStyle = '#ffcc00'; ctxYT.lineWidth = 2; ctxYT.stroke();
  }

  // Corner labels
  ctxYT.fillStyle = '#ff7aaa44'; ctxYT.font = '10px Segoe UI';
  ctxYT.textAlign = 'right'; ctxYT.fillText('(full trace preview)', W - MARG.right - 4, MARG.top - 8);
  ctxYT.fillStyle = '#ff7aaacc'; ctxYT.textAlign = 'left';
  ctxYT.fillText('Recording trace for x = x₀', MARG.left + 4, MARG.top - 8);

  // Annotations on top
  drawAnnotationsYT(t);
}

// ─── Main render ──────────────────────────────────────────────────
function render() {
  const t = frame * dt_frame;
  drawYX(t);
  drawYT(t);
  document.getElementById('timeBadge').textContent    = `t = ${t.toFixed(2)} s`;
  document.getElementById('frameCounter').textContent = `Frame ${frame} / ${totalFrames}`;
}

function recordFrame() {
  const t = frame * dt_frame;
  ytData.push({ t, y: A * Math.sin(k * x0 - ω * t) });
}

// ─── Animation loop ───────────────────────────────────────────────
function tick(ts) {
  if (!playing) { lastTime = null; requestAnimationFrame(tick); return; }
  if (lastTime === null) lastTime = ts;
  accumMs += ts - lastTime;
  lastTime = ts;
  const msPerFrame = 1000 / speed;
  while (accumMs >= msPerFrame) {
    accumMs -= msPerFrame;
    if (frame < totalFrames) { frame++; recordFrame(); }
    else {
      playing = false;
      document.getElementById('btnPlayPause').textContent = '▶ Play';
      document.getElementById('btnPlayPause').classList.remove('active');
    }
  }
  render();
  requestAnimationFrame(tick);
}

recordFrame();
render();
requestAnimationFrame(tick);

// ─── Controls ─────────────────────────────────────────────────────
document.getElementById('btnPlayPause').addEventListener('click', () => {
  if (frame >= totalFrames && !playing) {
    frame = 0; ytData = []; accumMs = 0; recordFrame(); render();
    playing = true;
    document.getElementById('btnPlayPause').textContent = '⏸ Pause';
    document.getElementById('btnPlayPause').classList.add('active');
    return;
  }
  playing = !playing;
  const btn = document.getElementById('btnPlayPause');
  btn.textContent = playing ? '⏸ Pause' : '▶ Play';
  btn.classList.toggle('active', playing);
  accumMs = 0;
});

document.getElementById('btnStep').addEventListener('click', () => {
  playing = false;
  document.getElementById('btnPlayPause').textContent = '▶ Play';
  document.getElementById('btnPlayPause').classList.remove('active');
  if (frame < totalFrames) { frame++; recordFrame(); render(); }
});

document.getElementById('btnReset').addEventListener('click', () => {
  playing = false; frame = 0; ytData = []; accumMs = 0;
  recordFrame(); render();
  document.getElementById('btnPlayPause').textContent = '▶ Play';
  document.getElementById('btnPlayPause').classList.remove('active');
});

document.getElementById('speedSlider').addEventListener('input', function () {
  speed = parseInt(this.value);
  document.getElementById('speedVal').textContent = `×${speed}`;
  accumMs = 0;
});
</script>
</body>
